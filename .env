# AWS CloudFormation IaC Dashboard Configuration

# Demo Mode (set to False to use real AWS resources)
DEMO_MODE=False

# AWS Configuration (only needed if DEMO_MODE=False)
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Application Settings
PORT=5000
HOST=0.0.0.0
