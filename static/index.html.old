<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AWS CloudFormation Control Hub</title>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600;700&family=Sora:wght@300;500;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --aws-orange: #ff9900;
            --aws-dark: #232f3e;
            --terminal-green: #00ff41;
            --cyan-glow: #00fff5;
            --danger-red: #ff3366;
            --warning-yellow: #ffcc00;
            --bg-deep: #0d1117;
            --bg-card: #161b22;
            --bg-elevated: #1f2937;
            --border-dim: #30363d;
            --text-primary: #e6edf3;
            --text-muted: #8b949e;
            --success: #3fb950;
        }

        body {
            font-family: 'Sora', sans-serif;
            background: var(--bg-deep);
            color: var(--text-primary);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* Animated Grid Background */
        .tech-grid {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                linear-gradient(rgba(0, 255, 65, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 255, 65, 0.03) 1px, transparent 1px);
            background-size: 50px 50px;
            z-index: 0;
            pointer-events: none;
        }

        .glow-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.12;
            z-index: 0;
            pointer-events: none;
            animation: pulse 8s ease-in-out infinite;
        }

        .orb-1 {
            width: 600px;
            height: 600px;
            background: var(--aws-orange);
            top: -200px;
            right: -200px;
        }

        .orb-2 {
            width: 500px;
            height: 500px;
            background: var(--terminal-green);
            bottom: -150px;
            left: -150px;
            animation-delay: 2s;
        }

        .orb-3 {
            width: 400px;
            height: 400px;
            background: var(--cyan-glow);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation-delay: 4s;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.12; transform: scale(1); }
            50% { opacity: 0.18; transform: scale(1.1); }
        }

        .container {
            max-width: 1600px;
            margin: 0 auto;
            padding: 2rem;
            position: relative;
            z-index: 1;
        }

        /* Header */
        header {
            background: rgba(22, 27, 34, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid var(--border-dim);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
            animation: slideDown 0.6s ease-out;
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header-accent {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--aws-orange), var(--terminal-green), var(--cyan-glow));
            animation: gradientShift 3s ease infinite;
        }

        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.5rem;
        }

        h1 {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: -1px;
            background: linear-gradient(135deg, var(--aws-orange) 0%, var(--terminal-green) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 0 30px rgba(255, 153, 0, 0.3);
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1.2rem;
            background: rgba(0, 255, 65, 0.1);
            border: 1px solid var(--terminal-green);
            border-radius: 50px;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--terminal-green);
            box-shadow: 0 0 20px rgba(0, 255, 65, 0.2);
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: var(--terminal-green);
            border-radius: 50%;
            animation: blink 2s ease-in-out infinite;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: rgba(22, 27, 34, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid var(--border-dim);
            border-radius: 16px;
            padding: 1.8rem;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
            animation: fadeIn 0.6s ease-out backwards;
        }

        .stat-card:nth-child(1) { animation-delay: 0.1s; }
        .stat-card:nth-child(2) { animation-delay: 0.2s; }
        .stat-card:nth-child(3) { animation-delay: 0.3s; }
        .stat-card:nth-child(4) { animation-delay: 0.4s; }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .stat-card:hover {
            transform: translateY(-4px);
            border-color: var(--aws-orange);
            box-shadow: 0 8px 32px rgba(255, 153, 0, 0.2);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
        }

        .stat-card.ec2::before { background: var(--aws-orange); }
        .stat-card.s3::before { background: var(--terminal-green); }
        .stat-card.lambda::before { background: var(--cyan-glow); }
        .stat-card.rds::before { background: #9146ff; }

        .stat-label {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            margin-bottom: 0.8rem;
            font-weight: 600;
        }

        .stat-value {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--text-primary);
            line-height: 1;
            margin-bottom: 0.5rem;
        }

        .stat-change {
            font-size: 0.85rem;
            font-family: 'IBM Plex Mono', monospace;
            color: var(--success);
        }

        .stat-change.negative {
            color: var(--danger-red);
        }

        /* Main Content Grid */
        .content-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .panel {
            background: rgba(22, 27, 34, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid var(--border-dim);
            border-radius: 16px;
            padding: 2rem;
            animation: fadeIn 0.8s ease-out backwards;
            animation-delay: 0.5s;
        }

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border-dim);
        }

        .panel-title {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .panel-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .icon-deploy { background: rgba(255, 153, 0, 0.15); }
        .icon-stack { background: rgba(0, 255, 65, 0.15); }
        .icon-cost { background: rgba(0, 255, 245, 0.15); }
        .icon-logs { background: rgba(145, 70, 255, 0.15); }

        /* Action Buttons */
        .action-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .action-btn {
            font-family: 'Sora', sans-serif;
            padding: 1rem 1.5rem;
            border: 2px solid var(--border-dim);
            border-radius: 12px;
            background: var(--bg-elevated);
            color: var(--text-primary);
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            position: relative;
            overflow: hidden;
        }

        .action-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transition: left 0.5s ease;
        }

        .action-btn:hover::before {
            left: 100%;
        }

        .action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
        }

        .action-btn.create {
            border-color: var(--terminal-green);
            background: rgba(0, 255, 65, 0.1);
            color: var(--terminal-green);
        }

        .action-btn.create:hover {
            background: rgba(0, 255, 65, 0.2);
            box-shadow: 0 8px 24px rgba(0, 255, 65, 0.3);
        }

        .action-btn.update {
            border-color: var(--cyan-glow);
            background: rgba(0, 255, 245, 0.1);
            color: var(--cyan-glow);
        }

        .action-btn.update:hover {
            background: rgba(0, 255, 245, 0.2);
            box-shadow: 0 8px 24px rgba(0, 255, 245, 0.3);
        }

        .action-btn.delete {
            border-color: var(--danger-red);
            background: rgba(255, 51, 102, 0.1);
            color: var(--danger-red);
        }

        .action-btn.delete:hover {
            background: rgba(255, 51, 102, 0.2);
            box-shadow: 0 8px 24px rgba(255, 51, 102, 0.3);
        }

        .action-btn.view {
            border-color: var(--aws-orange);
            background: rgba(255, 153, 0, 0.1);
            color: var(--aws-orange);
        }

        .action-btn.view:hover {
            background: rgba(255, 153, 0, 0.2);
            box-shadow: 0 8px 24px rgba(255, 153, 0, 0.3);
        }

        /* Service Selector */
        .service-selector {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.8rem;
            margin-bottom: 1.5rem;
        }

        .service-option {
            padding: 1rem;
            border: 2px solid var(--border-dim);
            border-radius: 12px;
            background: var(--bg-elevated);
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .service-option:hover {
            border-color: var(--aws-orange);
            background: rgba(255, 153, 0, 0.1);
        }

        .service-option.selected {
            border-color: var(--terminal-green);
            background: rgba(0, 255, 65, 0.15);
            color: var(--terminal-green);
            box-shadow: 0 0 20px rgba(0, 255, 65, 0.2);
        }

        /* Stack List */
        .stack-list {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .stack-item {
            padding: 1.2rem;
            background: var(--bg-elevated);
            border: 1px solid var(--border-dim);
            border-radius: 12px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .stack-item:hover {
            border-color: var(--aws-orange);
            transform: translateX(4px);
        }

        .stack-name {
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 0.5rem;
            color: var(--text-primary);
        }

        .stack-meta {
            display: flex;
            gap: 1.5rem;
            font-size: 0.8rem;
            font-family: 'IBM Plex Mono', monospace;
            color: var(--text-muted);
        }

        .stack-status {
            display: inline-block;
            padding: 0.25rem 0.8rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .stack-status.active {
            background: rgba(0, 255, 65, 0.15);
            color: var(--terminal-green);
        }

        .stack-status.updating {
            background: rgba(255, 204, 0, 0.15);
            color: var(--warning-yellow);
        }

        .stack-status.failed {
            background: rgba(255, 51, 102, 0.15);
            color: var(--danger-red);
        }

        /* Cost Metrics */
        .cost-metric {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 0;
            border-bottom: 1px solid var(--border-dim);
        }

        .cost-metric:last-child {
            border-bottom: none;
        }

        .cost-label {
            font-size: 0.9rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .cost-value {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .cost-bar {
            width: 100%;
            height: 8px;
            background: var(--bg-elevated);
            border-radius: 10px;
            overflow: hidden;
            margin-top: 0.5rem;
        }

        .cost-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--terminal-green), var(--cyan-glow));
            border-radius: 10px;
            transition: width 1s ease;
        }

        /* Activity Log */
        .log-container {
            max-height: 400px;
            overflow-y: auto;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.85rem;
        }

        .log-container::-webkit-scrollbar {
            width: 8px;
        }

        .log-container::-webkit-scrollbar-track {
            background: var(--bg-elevated);
            border-radius: 10px;
        }

        .log-container::-webkit-scrollbar-thumb {
            background: var(--border-dim);
            border-radius: 10px;
        }

        .log-container::-webkit-scrollbar-thumb:hover {
            background: var(--aws-orange);
        }

        .log-entry {
            padding: 0.8rem;
            border-left: 3px solid transparent;
            margin-bottom: 0.5rem;
            background: var(--bg-elevated);
            border-radius: 6px;
            transition: all 0.3s ease;
        }

        .log-entry:hover {
            background: rgba(255, 153, 0, 0.1);
            border-left-color: var(--aws-orange);
        }

        .log-entry.success { border-left-color: var(--terminal-green); }
        .log-entry.warning { border-left-color: var(--warning-yellow); }
        .log-entry.error { border-left-color: var(--danger-red); }
        .log-entry.info { border-left-color: var(--cyan-glow); }

        .log-timestamp {
            color: var(--text-muted);
            font-size: 0.75rem;
            margin-bottom: 0.3rem;
        }

        .log-message {
            color: var(--text-primary);
            line-height: 1.5;
        }

        /* Full Width Panel */
        .full-panel {
            grid-column: 1 / -1;
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 1.6rem;
            }

            .action-grid {
                grid-template-columns: 1fr;
            }

            .service-selector {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(10px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            animation: fadeIn 0.3s ease;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: var(--bg-card);
            border: 1px solid var(--border-dim);
            border-radius: 20px;
            padding: 2.5rem;
            max-width: 600px;
            width: 90%;
            position: relative;
            animation: slideUp 0.4s ease;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-header {
            font-size: 1.5rem;
            font-weight: 800;
            margin-bottom: 1.5rem;
            color: var(--text-primary);
            font-family: 'IBM Plex Mono', monospace;
        }

        .modal-body {
            color: var(--text-muted);
            line-height: 1.8;
            margin-bottom: 2rem;
        }

        .modal-actions {
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
        }

        .modal-btn {
            padding: 0.8rem 2rem;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Sora', sans-serif;
        }

        .modal-btn.primary {
            background: var(--terminal-green);
            color: var(--bg-deep);
        }

        .modal-btn.primary:hover {
            background: var(--aws-orange);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(255, 153, 0, 0.4);
        }

        .modal-btn.secondary {
            background: var(--bg-elevated);
            color: var(--text-primary);
            border: 1px solid var(--border-dim);
        }

        .modal-btn.secondary:hover {
            background: var(--border-dim);
        }

        .close-modal {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            width: 32px;
            height: 32px;
            border: none;
            background: var(--bg-elevated);
            color: var(--text-muted);
            border-radius: 8px;
            cursor: pointer;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .close-modal:hover {
            background: var(--danger-red);
            color: white;
        }
    </style>
</head>
<body>
    <!-- Background Elements -->
    <div class="tech-grid"></div>
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
    <div class="glow-orb orb-3"></div>

    <div class="container">
        <!-- Header -->
        <header>
            <div class="header-accent"></div>
            <div class="header-content">
                <div>
                    <h1>⚡ AWS CloudFormation Control Hub</h1>
                    <p style="margin-top: 0.5rem; color: var(--text-muted); font-family: 'IBM Plex Mono', monospace; font-size: 0.9rem;">Multi-Service Infrastructure Management | Production Mode</p>
                </div>
                <div class="status-badge">
                    <span class="status-dot"></span>
                    <span>SYSTEM ONLINE</span>
                </div>
            </div>
        </header>

        <!-- Stats Grid -->
        <div class="stats-grid">
            <div class="stat-card ec2">
                <div class="stat-label">EC2 Instances</div>
                <div class="stat-value" id="ec2Count">0</div>
                <div class="stat-change">+2 this week</div>
            </div>
            <div class="stat-card s3">
                <div class="stat-label">S3 Buckets</div>
                <div class="stat-value" id="s3Count">0</div>
                <div class="stat-change">+1 this week</div>
            </div>
            <div class="stat-card lambda">
                <div class="stat-label">Lambda Functions</div>
                <div class="stat-value" id="lambdaCount">0</div>
                <div class="stat-change">+3 this week</div>
            </div>
            <div class="stat-card rds">
                <div class="stat-label">RDS Databases</div>
                <div class="stat-value" id="rdsCount">0</div>
                <div class="stat-change negative">-1 this week</div>
            </div>
        </div>

        <!-- Main Content Grid -->
        <div class="content-grid">
            <!-- Deploy Panel -->
            <div class="panel">
                <div class="panel-header">
                    <div class="panel-title">
                        <div class="panel-icon icon-deploy">🚀</div>
                        Deploy Infrastructure
                    </div>
                </div>

                <div class="service-selector">
                    <div class="service-option selected" data-service="ec2">
                        💻 EC2 Instance
                    </div>
                    <div class="service-option" data-service="s3">
                        🗄️ S3 Bucket
                    </div>
                    <div class="service-option" data-service="lambda">
                        ⚡ Lambda Function
                    </div>
                    <div class="service-option" data-service="rds">
                        🗃️ RDS Database
                    </div>
                </div>

                <div class="action-grid">
                    <button class="action-btn create" onclick="createStack()">
                        ➕ Create Stack
                    </button>
                    <button class="action-btn update" onclick="updateStack()">
                        🔄 Update Stack
                    </button>
                    <button class="action-btn view" onclick="viewState()">
                        📊 View State
                    </button>
                    <button class="action-btn delete" onclick="deleteStack()">
                        🗑️ Delete Stack
                    </button>
                </div>
            </div>

            <!-- Active Stacks Panel -->
            <div class="panel">
                <div class="panel-header">
                    <div class="panel-title">
                        <div class="panel-icon icon-stack">📚</div>
                        Active CloudFormation Stacks
                    </div>
                </div>

                <div class="stack-list" id="stackList">
                    <!-- Stacks will be dynamically added -->
                </div>
            </div>

            <!-- Cost Analysis Panel -->
            <div class="panel">
                <div class="panel-header">
                    <div class="panel-title">
                        <div class="panel-icon icon-cost">💰</div>
                        Cost Analysis
                    </div>
                </div>

                <div class="cost-metric">
                    <span class="cost-label">Current Month</span>
                    <span class="cost-value">$0.00</span>
                </div>
                <div class="cost-bar">
                    <div class="cost-fill" style="width: 0%" id="currentCostBar"></div>
                </div>

                <div class="cost-metric" style="margin-top: 1rem;">
                    <span class="cost-label">Projected (EOMonth)</span>
                    <span class="cost-value">$0.00</span>
                </div>
                <div class="cost-bar">
                    <div class="cost-fill" style="width: 0%" id="projectedCostBar"></div>
                </div>

                <div class="cost-metric" style="margin-top: 1rem;">
                    <span class="cost-label">Budget Remaining</span>
                    <span class="cost-value" style="color: var(--terminal-green);">$500.00</span>
                </div>
                <div class="cost-bar">
                    <div class="cost-fill" style="width: 100%; background: linear-gradient(90deg, var(--terminal-green), var(--success));" id="budgetBar"></div>
                </div>
            </div>

            <!-- Activity Log Panel -->
            <div class="panel">
                <div class="panel-header">
                    <div class="panel-title">
                        <div class="panel-icon icon-logs">📝</div>
                        Activity Log
                    </div>
                </div>

                <div class="log-container" id="activityLog">
                    <!-- Logs will be dynamically added -->
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal" id="modal">
        <div class="modal-content">
            <button class="close-modal" onclick="closeModal()">✕</button>
            <div class="modal-header" id="modalTitle">Action Required</div>
            <div class="modal-body" id="modalBody">
                This is a demo mode message.
            </div>
            <div class="modal-actions">
                <button class="modal-btn secondary" onclick="closeModal()">Cancel</button>
                <button class="modal-btn primary" onclick="confirmAction()">Confirm</button>
            </div>
        </div>
    </div>

    <script>
        // State Management
        let selectedService = 'ec2';
        let stacks = [];
        let logs = [];
        let currentAction = null;
        
        const serviceCounts = {
            ec2: 0,
            s3: 0,
            lambda: 0,
            rds: 0
        };

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            initializeServiceSelector();
            loadInitialData();
            animateCounters();
        });

        // Service Selection
        function initializeServiceSelector() {
            const options = document.querySelectorAll('.service-option');
            options.forEach(option => {
                option.addEventListener('click', () => {
                    options.forEach(opt => opt.classList.remove('selected'));
                    option.classList.add('selected');
                    selectedService = option.dataset.service;
                });
            });
        }

        // Counter Animation
        function animateCounters() {
            setTimeout(() => {
                animateCounter('ec2Count', 5, 2000);
                animateCounter('s3Count', 3, 2000);
                animateCounter('lambdaCount', 7, 2000);
                animateCounter('rdsCount', 2, 2000);
            }, 500);
        }

        function animateCounter(id, target, duration) {
            const element = document.getElementById(id);
            const start = 0;
            const increment = target / (duration / 50);
            let current = start;

            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    element.textContent = target;
                    clearInterval(timer);
                } else {
                    element.textContent = Math.floor(current);
                }
            }, 50);
        }

        // Load Initial Data
        function loadInitialData() {
            const initialStacks = [
                {
                    name: 'web-app-prod-stack',
                    service: 'EC2',
                    status: 'active',
                    region: 'us-east-1',
                    created: '2 days ago'
                },
                {
                    name: 'data-pipeline-stack',
                    service: 'Lambda',
                    status: 'active',
                    region: 'us-west-2',
                    created: '1 week ago'
                },
                {
                    name: 'storage-backup-stack',
                    service: 'S3',
                    status: 'updating',
                    region: 'eu-west-1',
                    created: '3 days ago'
                }
            ];

            stacks = initialStacks;
            renderStacks();

            const initialLogs = [
                { type: 'success', message: 'Stack "web-app-prod-stack" created successfully', timestamp: '2 minutes ago' },
                { type: 'info', message: 'CloudFormation template validated for Lambda deployment', timestamp: '15 minutes ago' },
                { type: 'warning', message: 'S3 bucket approaching storage limit', timestamp: '1 hour ago' },
                { type: 'success', message: 'RDS instance backup completed', timestamp: '3 hours ago' },
                { type: 'error', message: 'Failed to update security group rules', timestamp: '5 hours ago' }
            ];

            logs = initialLogs;
            renderLogs();

            // Animate cost bars
            setTimeout(() => {
                document.getElementById('currentCostBar').style.width = '35%';
                document.getElementById('projectedCostBar').style.width = '70%';
            }, 1000);
        }

        // Render Stacks
        function renderStacks() {
            const stackList = document.getElementById('stackList');
            
            if (stacks.length === 0) {
                stackList.innerHTML = `
                    <div style="text-align: center; padding: 2rem; color: var(--text-muted);">
                        <p style="font-family: 'IBM Plex Mono', monospace;">No active stacks</p>
                        <p style="font-size: 0.85rem; margin-top: 0.5rem;">Create your first stack to get started</p>
                    </div>
                `;
                return;
            }

            stackList.innerHTML = stacks.map(stack => `
                <div class="stack-item">
                    <div class="stack-name">${stack.name}</div>
                    <div class="stack-meta">
                        <span>${stack.service}</span>
                        <span>•</span>
                        <span>${stack.region}</span>
                        <span>•</span>
                        <span>${stack.created}</span>
                    </div>
                    <div style="margin-top: 0.8rem;">
                        <span class="stack-status ${stack.status}">${stack.status}</span>
                    </div>
                </div>
            `).join('');
        }

        // Render Logs
        function renderLogs() {
            const logContainer = document.getElementById('activityLog');
            
            if (logs.length === 0) {
                logContainer.innerHTML = `
                    <div style="text-align: center; padding: 2rem; color: var(--text-muted);">
                        <p style="font-family: 'IBM Plex Mono', monospace;">No activity logs</p>
                    </div>
                `;
                return;
            }

            logContainer.innerHTML = logs.map(log => `
                <div class="log-entry ${log.type}">
                    <div class="log-timestamp">${log.timestamp}</div>
                    <div class="log-message">${log.message}</div>
                </div>
            `).join('');
        }

        // Add Log Entry
        function addLog(type, message) {
            const timestamp = 'Just now';
            logs.unshift({ type, message, timestamp });
            if (logs.length > 10) logs.pop();
            renderLogs();
        }

        // Create Stack
        function createStack() {
            currentAction = 'create';
            const serviceNames = {
                ec2: 'EC2 Instance',
                s3: 'S3 Bucket',
                lambda: 'Lambda Function',
                rds: 'RDS Database'
            };

            showModal(
                'Create CloudFormation Stack',
                `You're about to create a new ${serviceNames[selectedService]} using CloudFormation. This will:<br><br>
                • Generate a CloudFormation template<br>
                • Provision the ${serviceNames[selectedService]}<br>
                • Configure security groups and IAM roles<br>
                • Add monitoring and logging<br><br>
                <strong>Demo Mode:</strong> This simulates real AWS deployment without actual resource creation.`
            );
        }

        // Update Stack
        function updateStack() {
            currentAction = 'update';
            showModal(
                'Update CloudFormation Stack',
                `Update an existing stack with new configuration. This will:<br><br>
                • Create a change set<br>
                • Preview changes before applying<br>
                • Execute rolling updates<br>
                • Maintain zero-downtime deployment<br><br>
                <strong>Demo Mode:</strong> Simulating stack update process.`
            );
        }

        // Delete Stack
        function deleteStack() {
            currentAction = 'delete';
            showModal(
                'Delete CloudFormation Stack',
                `⚠️ <strong>Warning:</strong> This will delete the stack and all associated resources:<br><br>
                • All resources will be terminated<br>
                • Data may be lost permanently<br>
                • This action cannot be undone<br><br>
                <strong>Demo Mode:</strong> No actual resources will be deleted.`
            );
        }

        // View State
        function viewState() {
            currentAction = 'view';
            showModal(
                'View CloudFormation State',
                `View the current state of your infrastructure:<br><br>
                • Stack resources and outputs<br>
                • Parameter values<br>
                • Stack events and history<br>
                • Resource dependencies<br><br>
                <strong>Demo Mode:</strong> Displaying simulated stack state.`
            );
        }

        // Confirm Action
        function confirmAction() {
            closeModal();

            const serviceEmojis = {
                ec2: '💻',
                s3: '🗄️',
                lambda: '⚡',
                rds: '🗃️'
            };

            const serviceNames = {
                ec2: 'EC2',
                s3: 'S3',
                lambda: 'Lambda',
                rds: 'RDS'
            };

            switch(currentAction) {
                case 'create':
                    const stackName = `${selectedService}-stack-${Date.now().toString().slice(-4)}`;
                    stacks.unshift({
                        name: stackName,
                        service: serviceNames[selectedService],
                        status: 'active',
                        region: 'us-east-1',
                        created: 'Just now'
                    });
                    renderStacks();
                    addLog('success', `Stack "${stackName}" created successfully with ${serviceNames[selectedService]} resources`);
                    
                    serviceCounts[selectedService]++;
                    animateCounter(`${selectedService}Count`, serviceCounts[selectedService], 1000);
                    
                    updateCostMetrics();
                    break;

                case 'update':
                    if (stacks.length > 0) {
                        stacks[0].status = 'updating';
                        renderStacks();
                        addLog('info', `Updating stack "${stacks[0].name}" with new configuration`);
                        
                        setTimeout(() => {
                            stacks[0].status = 'active';
                            renderStacks();
                            addLog('success', `Stack "${stacks[0].name}" updated successfully`);
                        }, 3000);
                    }
                    break;

                case 'delete':
                    if (stacks.length > 0) {
                        const deletedStack = stacks.shift();
                        renderStacks();
                        addLog('warning', `Stack "${deletedStack.name}" deletion initiated`);
                        
                        const serviceKey = deletedStack.service.toLowerCase();
                        if (serviceCounts[serviceKey] > 0) {
                            serviceCounts[serviceKey]--;
                            animateCounter(`${serviceKey}Count`, serviceCounts[serviceKey], 1000);
                        }
                        
                        updateCostMetrics();
                    }
                    break;

                case 'view':
                    if (stacks.length > 0) {
                        addLog('info', `Viewing state for stack "${stacks[0].name}"`);
                    }
                    break;
            }

            currentAction = null;
        }

        // Update Cost Metrics
        function updateCostMetrics() {
            const totalStacks = stacks.length;
            const currentCost = totalStacks * 12.50;
            const projectedCost = currentCost * 1.8;
            const budget = 500;
            
            const costElements = document.querySelectorAll('.cost-value');
            costElements[0].textContent = `$${currentCost.toFixed(2)}`;
            costElements[1].textContent = `$${projectedCost.toFixed(2)}`;
            costElements[2].textContent = `$${(budget - currentCost).toFixed(2)}`;
            
            document.getElementById('currentCostBar').style.width = `${(currentCost / budget) * 100}%`;
            document.getElementById('projectedCostBar').style.width = `${(projectedCost / budget) * 100}%`;
            document.getElementById('budgetBar').style.width = `${((budget - currentCost) / budget) * 100}%`;
        }

        // Modal Functions
        function showModal(title, body) {
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalBody').innerHTML = body;
            document.getElementById('modal').classList.add('active');
        }

        function closeModal() {
            document.getElementById('modal').classList.remove('active');
        }

        // Close modal on outside click
        document.getElementById('modal').addEventListener('click', (e) => {
            if (e.target.id === 'modal') {
                closeModal();
            }
        });
    </script>
</body>
</html>
