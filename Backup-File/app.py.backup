}


class CloudFormationManager:
    def __init__(self, demo_mode=True):
        self.demo_mode = demo_mode
        if not demo_mode:
            self.client = boto3.client('cloudformation', region_name='us-east-1')
    
    def create_stack(self, stack_name, service_type):
        """Create a new CloudFormation stack"""
        if service_type not in TEMPLATES:
            return {'error': f'Unknown service type: {service_type}'}, 400
        
        template = TEMPLATES[service_type]
        
        if self.demo_mode:
            # Demo mode - simulate stack creation
            stack_id = f'arn:aws:cloudformation:us-east-1:123456789012:stack/{stack_name}/{uuid.uuid4()}'
            stack = {
                'StackId': stack_id,
                'StackName': stack_name,
                'Status': 'CREATE_COMPLETE',
                'ServiceType': service_type.upper(),
                'CreationTime': datetime.now().isoformat(),
                'Region': 'us-east-1',
                'Template': template
            }
            stacks_db.append(stack)
            
            log_entry = {
                'timestamp': datetime.now().isoformat(),
                'type': 'success',
                'message': f'Stack "{stack_name}" created successfully for {service_type.upper()}'
            }
            logs_db.append(log_entry)
            
            return {'stack': stack, 'message': 'Stack created successfully (Demo Mode)'}, 200
        else:
            # Real AWS mode
            try:
                response = self.client.create_stack(
                    StackName=stack_name,
                    TemplateBody=json.dumps(template),
                    Capabilities=['CAPABILITY_IAM']
                )
                return {'stack_id': response['StackId'], 'message': 'Stack creation initiated'}, 200
            except Exception as e:
                return {'error': str(e)}, 500
    
    def update_stack(self, stack_name, service_type):
        """Update an existing CloudFormation stack"""
        if self.demo_mode:
            for stack in stacks_db:
                if stack['StackName'] == stack_name:
                    stack['Status'] = 'UPDATE_IN_PROGRESS'
                    log_entry = {
                        'timestamp': datetime.now().isoformat(),
                        'type': 'info',
                        'message': f'Stack "{stack_name}" update initiated'
                    }
                    logs_db.append(log_entry)
                    return {'message': 'Stack update initiated (Demo Mode)'}, 200
            return {'error': 'Stack not found'}, 404
        else:
            try:
                template = TEMPLATES.get(service_type, TEMPLATES['ec2'])
                response = self.client.update_stack(
                    StackName=stack_name,
                    TemplateBody=json.dumps(template),
                    Capabilities=['CAPABILITY_IAM']
                )
                return {'stack_id': response['StackId'], 'message': 'Stack update initiated'}, 200
            except Exception as e:
                return {'error': str(e)}, 500
    
    def delete_stack(self, stack_name):
        """Delete a CloudFormation stack"""
        if self.demo_mode:
            for i, stack in enumerate(stacks_db):
                if stack['StackName'] == stack_name:
                    deleted_stack = stacks_db.pop(i)
                    log_entry = {
                        'timestamp': datetime.now().isoformat(),
                        'type': 'warning',
                        'message': f'Stack "{stack_name}" deleted successfully'
                    }
                    logs_db.append(log_entry)
                    return {'message': 'Stack deleted successfully (Demo Mode)'}, 200
            return {'error': 'Stack not found'}, 404
        else:
            try:
                self.client.delete_stack(StackName=stack_name)
                return {'message': 'Stack deletion initiated'}, 200
            except Exception as e:
                return {'error': str(e)}, 500
    
    def list_stacks(self):
        """List all CloudFormation stacks"""
        if self.demo_mode:
            return {'stacks': stacks_db}, 200
        else:
            try:
                response = self.client.list_stacks(
                    StackStatusFilter=['CREATE_COMPLETE', 'UPDATE_COMPLETE']
                )
                return {'stacks': response['StackSummaries']}, 200
            except Exception as e:
                return {'error': str(e)}, 500
    
    def get_stack_state(self, stack_name):
        """Get the current state of a stack"""
        if self.demo_mode:
            for stack in stacks_db:
                if stack['StackName'] == stack_name:
                    state = {
                        'StackName': stack['StackName'],
                        'Status': stack['Status'],
                        'CreationTime': stack['CreationTime'],
                        'Resources': list(stack['Template']['Resources'].keys()),
                        'Outputs': stack['Template'].get('Outputs', {}),
                        'Parameters': {}
                    }
                    return {'state': state}, 200
            return {'error': 'Stack not found'}, 404
        else:
            try:
                response = self.client.describe_stacks(StackName=stack_name)
                stack = response['Stacks'][0]
                return {'state': stack}, 200
            except Exception as e:
                return {'error': str(e)}, 500


# Initialize CloudFormation manager
cfn_manager = CloudFormationManager(demo_mode=DEMO_MODE)


# API Routes
@app.route('/api/health', methods=['GET'])
def health_check():
    """Health check endpoint"""
    return jsonify({
        'status': 'healthy',
        'demo_mode': DEMO_MODE,
        'timestamp': datetime.now().isoformat()
    })


@app.route('/api/stacks', methods=['GET'])
def list_stacks():
    """List all CloudFormation stacks"""
    result, status = cfn_manager.list_stacks()
    return jsonify(result), status


@app.route('/api/stacks/create', methods=['POST'])
def create_stack():
    """Create a new CloudFormation stack"""
    data = request.json
    stack_name = data.get('stackName')
    service_type = data.get('serviceType', 'ec2').lower()
    
    if not stack_name:
        return jsonify({'error': 'Stack name is required'}), 400
    
    result, status = cfn_manager.create_stack(stack_name, service_type)
    return jsonify(result), status


@app.route('/api/stacks/update', methods=['POST'])
def update_stack():
    """Update an existing CloudFormation stack"""
    data = request.json
    stack_name = data.get('stackName')
    service_type = data.get('serviceType', 'ec2').lower()
    
    if not stack_name:
        return jsonify({'error': 'Stack name is required'}), 400
    
    result, status = cfn_manager.update_stack(stack_name, service_type)
    return jsonify(result), status


@app.route('/api/stacks/delete/<stack_name>', methods=['DELETE'])
def delete_stack(stack_name):
    """Delete a CloudFormation stack"""
    result, status = cfn_manager.delete_stack(stack_name)
    return jsonify(result), status


@app.route('/api/stacks/<stack_name>/state', methods=['GET'])
def get_stack_state(stack_name):
    """Get the current state of a stack"""
    result, status = cfn_manager.get_stack_state(stack_name)
    return jsonify(result), status


@app.route('/api/logs', methods=['GET'])
def get_logs():
    """Get activity logs"""
    return jsonify({'logs': logs_db[-20:]})  # Return last 20 logs


@app.route('/api/costs', methods=['GET'])
def get_costs():
    """Get cost analysis (simulated)"""
    num_stacks = len(stacks_db)
    current_cost = num_stacks * 12.50
    projected_cost = current_cost * 1.8
    budget = 500.0
    
    return jsonify({
        'current': round(current_cost, 2),
        'projected': round(projected_cost, 2),
        'budget': budget,
        'remaining': round(budget - current_cost, 2)
    })


@app.route('/api/metrics', methods=['GET'])
def get_metrics():
    """Get infrastructure metrics"""
    service_counts = {'ec2': 0, 's3': 0, 'lambda': 0, 'rds': 0}
    
    for stack in stacks_db:
        service_type = stack.get('ServiceType', 'EC2').lower()
        if service_type in service_counts:
            service_counts[service_type] += 1
    
    return jsonify(service_counts)


if __name__ == '__main__':
    # Initialize with some demo data
    if DEMO_MODE:
        # Create initial demo stacks
        cfn_manager.create_stack('web-app-prod-stack', 'ec2')
        cfn_manager.create_stack('data-pipeline-stack', 'lambda')
        cfn_manager.create_stack('storage-backup-stack', 's3')
        
        # Add initial logs
        logs_db.append({
            'timestamp': datetime.now().isoformat(),
            'type': 'info',
            'message': 'CloudFormation Dashboard initialized in demo mode'
        })
    
    app.run(host='0.0.0.0', port=5000, debug=True)
