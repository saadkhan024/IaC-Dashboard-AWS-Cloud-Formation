"""
AWS CloudFormation IaC Dashboard Backend
Multi-Service Infrastructure Management System
"""

from flask import Flask, request, jsonify
from flask_cors import CORS
import boto3
import json
import uuid
from datetime import datetime
import os

app = Flask(__name__)
CORS(app)

# Demo mode - Set to True for simulated operations without real AWS calls
DEMO_MODE = os.getenv('DEMO_MODE', 'True').lower() == 'true'

# In-memory storage for demo mode
stacks_db = []
logs_db = []
state_db = {}

# CloudFormation Templates
TEMPLATES = {
    'ec2': {
        'AWSTemplateFormatVersion': '2010-09-09',
        'Description': 'EC2 Instance with Security Group',
        'Resources': {
            'MyEC2Instance': {
